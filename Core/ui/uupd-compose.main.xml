<?xml version='1.0' encoding='UTF-8'?>
<!--
    UUPD.Catcher — Main Window XAML Definition
    File:    Core\ui\uupd.catcher.main.xml
    Design:  WinTwin.Fusion shared dark UI, based on wim-mount.main.xml,
             wtf.console.main.xml and wintwin.fusion.installer.xml.
    Note:    Event handlers are intentionally attached by the PowerShell host.
--><Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UUPD.Compose"
    Width="660"
    Height="860"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen">


    <Window.Resources>
        <!-- Shared WinTwin.Fusion color palette -->
        <SolidColorBrush x:Key="BrushBg" Color="#121212"/>
        <SolidColorBrush x:Key="BrushSurface" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="BrushSurface2" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="BrushTitleBar" Color="#0F0F0F"/>
        <SolidColorBrush x:Key="BrushAccent" Color="#2cec0e"/>
        <SolidColorBrush x:Key="BrushAccentHover" Color="#43ff3d"/>
        <SolidColorBrush x:Key="BrushAccentDim" Color="#19b90a"/>
        <SolidColorBrush x:Key="BrushText" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="#888888"/>
        <SolidColorBrush x:Key="BrushTextFaint" Color="#444444"/>
        <SolidColorBrush x:Key="BrushBorder" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="BrushBtnClose" Color="#970f14"/>
        <SolidColorBrush x:Key="BrushBtnMinimize" Color="#c98c00"/>
        <SolidColorBrush x:Key="BrushInputBg" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="BrushInputBorder" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="BrushInputError" Color="#740509"/>
        <SolidColorBrush x:Key="BrushInputErrorBrdr" Color="#e4454a"/>

        <!-- Custom title-bar controls -->
        <Style x:Key="WinCtrlBtnMinimize" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="BtnEllipse" Fill="{TemplateBinding Background}" Width="20" Height="20"/>
                            <TextBlock x:Name="MinimizeGlyph" Text="⩡" FontSize="18" FontWeight="ExtraBold" Foreground="#f7b100" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,-4,0,0" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MinimizeGlyph" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnEllipse" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCtrlBtnClose" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="BtnEllipse" Fill="{TemplateBinding Background}" Width="20" Height="20"/>
                            <TextBlock x:Name="CloseGlyph" Text="×" FontSize="26" FontWeight="ExtraBold" Foreground="#f1242e" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center" Margin="0,-10,0,0" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseGlyph" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnEllipse" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text styles -->
        <Style x:Key="InstructionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusBarText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Text input: aligned with wim-mount.main.xml -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BrushInputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushAccent}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="{StaticResource BrushAccentDim}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Check box: installer-style appearance, with a green glyph only for $true -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsThreeState" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <Border x:Name="Box" CornerRadius="3" Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"/>
                                <TextBlock x:Name="SuccessGlyph" Text="✔" FontSize="15" FontWeight="ExtraLight" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="SuccessGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="SuccessGlyph" Property="Opacity" Value="0.45"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio button -->
        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="RadioOuter" Width="18" Height="18" CornerRadius="9" Background="{StaticResource BrushInputBg}" BorderBrush="{StaticResource BrushInputBorder}" BorderThickness="1" VerticalAlignment="Center">
                                <Ellipse x:Name="RadioDot" Width="8" Height="8" Fill="{StaticResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioDot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="RadioOuter" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioOuter" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon and action buttons -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource BrushInputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBtnBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconBtnBorder" Property="Background" Value="{StaticResource BrushAccentDim}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="IconBtnBorder" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActBtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActBtnBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActBtnBorder" Property="Background" Value="{StaticResource BrushAccentDim}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}"/>
                                <Setter TargetName="ActBtnBorder" Property="Background" Value="{StaticResource BrushSurface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Installer-style process indicator -->
        <Style x:Key="ProcessProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="OuterBorder" CornerRadius="10" Background="{StaticResource BrushBg}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.6" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar: fixed window, minimize + close only -->
            <Border Grid.Row="0" Background="{StaticResource BrushTitleBar}" CornerRadius="10,10,0,0">
                <Grid x:Name="TitleBarPanel" Background="Transparent" Cursor="Arrow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="TitleBarLogo" Grid.Column="0" Width="20" Height="20" Margin="14,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TitleBarText" Grid.Column="1" Text="UUPD.Compose" Foreground="{StaticResource BrushTextMuted}" FontFamily="Segoe UI" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Button x:Name="BtnMinimize" Style="{StaticResource WinCtrlBtnMinimize}" Background="{StaticResource BrushBtnMinimize}" ToolTip="Minimize"/>
                        <Button x:Name="BtnClose" Style="{StaticResource WinCtrlBtnClose}" Background="{StaticResource BrushBtnClose}" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{StaticResource BrushBorder}"/>

            <!-- Main content -->
            <Grid x:Name="MainContentPanel" Grid.Row="1" Margin="24,16,24,14">
                <Grid.RowDefinitions>
                    <!-- Vertically balanced layout: content rows, deliberate block gaps, small footer reserve -->
                    <!-- ROW 00-01:  Header Text Labels -->
                    <RowDefinition Height="50"/>
                    <!-- SPACER -->
                    <RowDefinition Height="15"/>
                    <!-- ROW 10-12:  Download Location, ZIP-Filename, Checkbox -->
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <!-- SPACER -->
                    <RowDefinition Height="20"/>
                    <!-- INFOBOX -->
                    <RowDefinition Height="140"/>
                    <!-- SPACER -->
                    <RowDefinition Height="20"/>
                    <!-- ROW 14:  Buttons -->
                    <RowDefinition Height="46"/>
                    <!-- SPACER -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row 00 -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="LblInstructions" Height="30" Style="{StaticResource InstructionText}" Text="Please configure UUPD.Compose to create your ISO"/>
                    <TextBlock x:Name="LblComposeInfo" Height="20" Foreground="{StaticResource BrushTextMuted}" FontFamily="Segoe UI" FontSize="12" TextAlignment="Center" Margin="0,3,0,0" Text="UUPD.Compose creates an ISO-File from a previous download from uupdump.net."/>
                </StackPanel>

                <!-- Row 07 -->
                <TextBlock x:Name="LblDownloadSettings" Grid.Row="2" Style="{StaticResource SectionHeader}" Text="Where is the download from uupdump.net?" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="Bold"/>

                <!-- Row 10 -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblZIPlocation" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="ZIP-File Location" Margin="0,0,30,0"/>
                    <TextBox x:Name="TxtZIPlocation" Height="40" Grid.Column="1" Style="{StaticResource InputBox}" IsReadOnly="True" Margin="0,0,8,0"/>
                    <Button x:Name="BtnZIPLocation" Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Browse">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.9 21.1,6 20,6Z" Fill="{StaticResource BrushAccent}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <!-- Row 07 -->
                <TextBlock x:Name="LblISOfileSettings" Grid.Row="4" Style="{StaticResource SectionHeader}" Text="Where to create the ISO-File?" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="Bold"/>

                <!-- Row 10 -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblISOlocation" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="ISO-File Location" Margin="0,0,30,0"/>
                    <TextBox x:Name="TxtISOlocation" Height="40" Grid.Column="1" Style="{StaticResource InputBox}" IsReadOnly="True" Margin="0,0,8,0"/>
                    <Button x:Name="BtnISOLocation" Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Browse">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="22" Height="22" Fill="{StaticResource BrushAccent}"/>
                                <Ellipse Canvas.Left="9.5" Canvas.Top="9.5" Width="5" Height="5" Fill="{StaticResource BrushSurface2}"/>
                                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="22" Height="22" Stroke="{StaticResource BrushSurface2}" StrokeThickness="0.8"/>
                                <Path Data="M4,7 A10,10 0 0,1 15,3" Stroke="{StaticResource BrushSurface2}" StrokeThickness="1.4" Opacity="0.55"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <!-- Row 11 -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblISOFilename" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Filename (.iso)" Margin="0,0,30,0"/>
                    <TextBox x:Name="TxtFilename" Height="40" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource InputBox}"/>
                </Grid>

                <!-- Row 13: Important information -->
                <Border Grid.Row="8" Margin="0,8,0,8" Padding="16,10,16,10" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6">
                    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,7">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="{StaticResource BrushAccent}" StrokeThickness="2"/>
                                    <Ellipse Canvas.Left="11" Canvas.Top="6" Width="2" Height="2" Fill="{StaticResource BrushAccent}"/>
                                    <Path Data="M12,10 L12,17" Stroke="{StaticResource BrushAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="LblImportantInformation" Text="Important Information!" Foreground="{StaticResource BrushText}" FontFamily="Segoe UI Semibold" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtImportantInformation"
                                   Text="Creating the ISO file can take a considerable amount of time (depending on the computer).&#10;It may appear as though the program has stopped responding. Terminating the program&#10;prematurely could result in data loss. Therefore, please wait until the program indicates&#10;that the ISO file has been created."
                                   Foreground="{StaticResource BrushTextMuted}" FontFamily="Segoe UI Semilight" FontSize="14" FontWeight="Light" TextAlignment="Justify" TextWrapping="Wrap" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- Row 14 -->
                <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnCreateISO" Style="{StaticResource ActionButton}" Content="Create ISO" Margin="0,0,30,0"/>
                    <!-- <Button x:Name="BtnCancel" Style="{StaticResource ActionButton}" Content="Cancel" Margin="0,0,30,0"/> -->
                    <Button x:Name="BtnExitApp" Style="{StaticResource ActionButton}" Content="Exit"/>
                </StackPanel>
            </Grid>

            <!-- Installer-style process indicator directly above the status bar -->
            <ProgressBar x:Name="PrgDownload" Grid.Row="2" Style="{StaticResource ProcessProgressBar}" Margin="1,0,1,0" Value="0"/>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="{StaticResource BrushTitleBar}" CornerRadius="0,0,10,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" Text="Ready" Style="{StaticResource StatusBarText}"/>
                    <TextBlock x:Name="StatusInfo" Grid.Column="1" Text="UUPD.Compose v1.00.00" Style="{StaticResource StatusBarText}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>