<?xml version="1.0" encoding="UTF-8"?>
<!--
    UUPD.Compose - Information Popup
    Extracted and adapted from Core/ui/uupd-compose.main.xml.
    Event handlers are intentionally attached by the PowerShell host.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Important Information"
        Width="620"
        Height="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="BrushBg" Color="#121212"/>
        <SolidColorBrush x:Key="BrushSurface" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="BrushTitleBar" Color="#0F0F0F"/>
        <SolidColorBrush x:Key="BrushAccent" Color="#2cec0e"/>
        <SolidColorBrush x:Key="BrushAccentHover" Color="#43ff3d"/>
        <SolidColorBrush x:Key="BrushAccentDim" Color="#19b90a"/>
        <SolidColorBrush x:Key="BrushText" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="#888888"/>
        <SolidColorBrush x:Key="BrushTextFaint" Color="#444444"/>
        <SolidColorBrush x:Key="BrushBorder" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="BrushBtnClose" Color="#970f14"/>
        <SolidColorBrush x:Key="BrushSurface2" Color="#1F1F1F"/>

        <Style x:Key="WinCtrlBtnClose" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="BtnEllipse" Fill="{TemplateBinding Background}" Width="20" Height="20"/>
                            <TextBlock x:Name="CloseGlyph" Text="×" FontSize="26" FontWeight="ExtraBold"
                                       Foreground="#f1242e" HorizontalAlignment="Center" VerticalAlignment="Top"
                                       TextAlignment="Center" Margin="0,-10,0,0" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseGlyph" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnEllipse" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActBtnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActBtnBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActBtnBorder" Property="Background" Value="{StaticResource BrushAccentDim}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}"/>
                                <Setter TargetName="ActBtnBorder" Property="Background" Value="{StaticResource BrushSurface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="OuterBorder" CornerRadius="10" Background="{StaticResource BrushBg}"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.6" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BrushTitleBar}" CornerRadius="10,10,0,0">
                <Grid x:Name="TitleBarPanel" Background="Transparent" Cursor="Arrow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Important Information" Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="Segoe UI" FontSize="14" HorizontalAlignment="Center"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Button x:Name="BtnClose" Grid.Column="2" Style="{StaticResource WinCtrlBtnClose}"
                            Background="{StaticResource BrushBtnClose}" ToolTip="Close"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{StaticResource BrushBorder}"/>

            <Grid Grid.Row="1" Margin="28,20,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="38"/>
                </Grid.RowDefinitions>

                <!-- Heading moved above the gray information box and enlarged. -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Viewbox Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"
                                     Stroke="{StaticResource BrushAccent}" StrokeThickness="2"/>
                            <Ellipse Canvas.Left="11" Canvas.Top="6" Width="2" Height="2"
                                     Fill="{StaticResource BrushAccent}"/>
                            <Path Data="M12,10 L12,17" Stroke="{StaticResource BrushAccent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="LblImportantInformation" Text="Important Information!"
                               Foreground="{StaticResource BrushText}" FontFamily="Segoe UI Semibold"
                               FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- The gray box now contains only the detailed information text. -->
                <Border Grid.Row="1" Padding="18,14" Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6">
                    <TextBlock x:Name="TxtImportantInformation"
                               Text="Creating the ISO file can take a considerable amount of time (depending on the computer).&#10;It may appear as though the program has stopped responding. Terminating the program&#10;prematurely could result in data loss. Therefore, please wait until the program indicates&#10;that the ISO file has been created."
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="Segoe UI Semilight"
                               FontSize="14" FontWeight="Light" TextAlignment="Justify"
                               TextWrapping="Wrap" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnYes" Style="{StaticResource ActionButton}" Content="Yes" Margin="0,0,30,0" IsDefault="True"/>
                    <Button x:Name="BtnNo" Style="{StaticResource ActionButton}" Content="No" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
