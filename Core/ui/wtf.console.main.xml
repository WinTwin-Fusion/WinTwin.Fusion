<?xml version="1.0" encoding="utf-8"?>
<!--
    WTF.Console v1.00.00 — Main Window XAML Definition
    File:      Core\ui\wtf.console.main.xml   (Framework)  /  wtf.data\wtf.console.main.xml (Standalone)
    Purpose:   Defines the WPF UI for WTF.Console, a graphical wrapper around the Windows
               console/terminal used to redirect and monitor the I/O stream of an internally
               started, hidden console process. No inline XAML is used anywhere in the
               PowerShell source of WTF.Console.ps1 - this file is always loaded externally.

    Design:    Same visual identity as DISM.UI.CC / wim.mounter.main.xml (dark palette,
               rounded frameless window, custom title bar). Unlike wim.mounter, WTF.Console
               additionally exposes a Minimize button (both modes) and a Maximize button
               (Standalone mode only - hidden/collapsed in Framework mode by the script).
               The content area hosts a single, large, read-only terminal output TextBox
               and a single-line input TextBox at the bottom, mirroring a real terminal.

    Author:    praetoriani
    Version:   1.00.00   Date: 20.08.2026
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WTF.Console"
    Width="800"
    Height="600"
    MinWidth="480"
    MinHeight="320"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  COLOR PALETTE - copied 1:1 from PowerEdge / wim.mounter            -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="BrushBg"             Color="#121212"/>
        <SolidColorBrush x:Key="BrushSurface"        Color="#1A1A1A"/>
        <SolidColorBrush x:Key="BrushSurface2"       Color="#1F1F1F"/>
        <SolidColorBrush x:Key="BrushTitleBar"       Color="#0F0F0F"/>
        <SolidColorBrush x:Key="BrushAccent"         Color="#2cec0e"/>
        <SolidColorBrush x:Key="BrushAccentHover"    Color="#43ff3d"/>
        <SolidColorBrush x:Key="BrushAccentDim"      Color="#19b90a"/>
        <SolidColorBrush x:Key="BrushText"           Color="#E8E8E8"/>
        <SolidColorBrush x:Key="BrushTextMuted"      Color="#888888"/>
        <SolidColorBrush x:Key="BrushTextFaint"      Color="#444444"/>
        <SolidColorBrush x:Key="BrushBorder"         Color="#2A2A2A"/>
        <SolidColorBrush x:Key="BrushBtnClose"       Color="#970f14"/>
        <SolidColorBrush x:Key="BrushBtnCloseHover"  Color="#c12025"/>
        <SolidColorBrush x:Key="BrushBtnMinimize"    Color="#F0A500"/>
        <SolidColorBrush x:Key="BrushBtnMaximize"    Color="#25A244"/>
        <SolidColorBrush x:Key="BrushTransparent"    Color="Transparent"/>

        <SolidColorBrush x:Key="BrushInputBg"        Color="#1F1F1F"/>
        <SolidColorBrush x:Key="BrushInputBorder"    Color="#2A2A2A"/>
        <SolidColorBrush x:Key="BrushInputError"     Color="#740509"/>
        <SolidColorBrush x:Key="BrushInputErrorBrdr" Color="#e4454a"/>
        <SolidColorBrush x:Key="BrushTerminalBg"     Color="#0C0C0C"/>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  WINDOW CONTROL BUTTON STYLE (Close / Minimize / Maximize)         -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="WinCtrlBtn" TargetType="Button">
            <Setter Property="Width"             Value="20"/>
            <Setter Property="Height"            Value="20"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Focusable"         Value="False"/>
            <Setter Property="Margin"            Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="BtnEllipse" Fill="{TemplateBinding Background}" Width="17" Height="17"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnEllipse" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnEllipse" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  TEXT STYLES                                                        -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="StatusBarText" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="FontFamily"        Value="Segoe UI"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily"        Value="Segoe UI Semibold"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  TERMINAL OUTPUT TEXTBOX - read-only, selectable/copyable           -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="TerminalOutput" TargetType="TextBox">
            <Setter Property="Background"              Value="{StaticResource BrushTerminalBg}"/>
            <Setter Property="Foreground"               Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush"               Value="{StaticResource BrushInputBorder}"/>
            <Setter Property="BorderThickness"           Value="1"/>
            <Setter Property="Padding"                   Value="10,8"/>
            <Setter Property="FontFamily"                Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize"                  Value="13"/>
            <Setter Property="IsReadOnly"                Value="True"/>
            <Setter Property="TextWrapping"               Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="CaretBrush"                Value="{StaticResource BrushAccent}"/>
            <Setter Property="SelectionBrush"            Value="{StaticResource BrushAccentDim}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  INPUT TEXTBOX STYLE (prompt line)                                  -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background"            Value="{StaticResource BrushInputBg}"/>
            <Setter Property="Foreground"            Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush"            Value="{StaticResource BrushInputBorder}"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="Padding"                Value="10,7"/>
            <Setter Property="FontFamily"             Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize"               Value="13"/>
            <Setter Property="CaretBrush"             Value="{StaticResource BrushAccent}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush"         Value="{StaticResource BrushAccentDim}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  ACTION BUTTON STYLE (Send / Clear / Exit)                         -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height"          Value="32"/>
            <Setter Property="MinWidth"         Value="88"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Background"       Value="{StaticResource BrushSurface2}"/>
            <Setter Property="BorderBrush"       Value="{StaticResource BrushBorder}"/>
            <Setter Property="Foreground"        Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily"        Value="Segoe UI Semibold"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="Focusable"          Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActBtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActBtnBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActBtnBorder" Property="Background" Value="{StaticResource BrushAccentDim}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}"/>
                                <Setter TargetName="ActBtnBorder" Property="Background" Value="{StaticResource BrushSurface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ╔════════════════════════════════════════════════════════════════════╗ -->
    <!--  OUTER WINDOW BORDER - rounded corners + drop shadow (1:1 PowerEdge) -->
    <!-- ╚════════════════════════════════════════════════════════════════════╝ -->
    <Border x:Name="OuterBorder"
            CornerRadius="10"
            Background="{StaticResource BrushBg}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#000000"
                               BlurRadius="32"
                               ShadowDepth="8"
                               Opacity="0.6"
                               Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>  <!-- Custom title bar     -->
                <RowDefinition Height="*"/>   <!-- Terminal content     -->
                <RowDefinition Height="26"/>  <!-- Status bar           -->
            </Grid.RowDefinitions>

            <!-- ──────────────────────────────────────────────────────────── -->
            <!--  ROW 0 - CUSTOM TITLE BAR                                    -->
            <!-- ──────────────────────────────────────────────────────────── -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{StaticResource BrushTitleBar}"
                    CornerRadius="10,10,0,0">

                <Grid x:Name="TitleBarPanel"
                      Background="Transparent"
                      Cursor="Arrow">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>  <!-- App icon                    -->
                        <ColumnDefinition Width="*"/>     <!-- Title text (centered)       -->
                        <ColumnDefinition Width="Auto"/>  <!-- Minimize/Maximize/Close     -->
                    </Grid.ColumnDefinitions>

                    <Image x:Name="TitleBarLogo"
                           Grid.Column="0"
                           Width="20" Height="20"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <TextBlock x:Name="TitleBarText"
                               Grid.Column="1"
                               Text="WTF.Console"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">

                        <Button x:Name="BtnMinimize"
                                Style="{StaticResource WinCtrlBtn}"
                                Background="{StaticResource BrushBtnMinimize}"
                                ToolTip="Minimize">
                            <TextBlock Text="&#8212;" FontSize="11" FontWeight="Bold" Foreground="#5a3d00"/>
                        </Button>

                        <Button x:Name="BtnMaximize"
                                Style="{StaticResource WinCtrlBtn}"
                                Background="{StaticResource BrushBtnMaximize}"
                                ToolTip="Maximize">
                            <TextBlock Text="&#9723;" FontSize="10" FontWeight="Bold" Foreground="#0d3b1a"/>
                        </Button>

                        <Button x:Name="BtnClose"
                                Style="{StaticResource WinCtrlBtn}"
                                Background="{StaticResource BrushBtnClose}"
                                ToolTip="Close">
                            <TextBlock Text="&#215;" FontSize="14" FontWeight="Bold" Foreground="#3c0507"/>
                        </Button>

                    </StackPanel>

                </Grid>
            </Border>

            <Rectangle Grid.Row="0"
                       Height="1"
                       VerticalAlignment="Bottom"
                       Fill="{StaticResource BrushBorder}"/>

            <!-- ──────────────────────────────────────────────────────────── -->
            <!--  ROW 1 - TERMINAL CONTENT AREA                               -->
            <!-- ──────────────────────────────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="16,14,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>    <!-- Terminal output       -->
                    <RowDefinition Height="10"/>   <!-- Spacer                -->
                    <RowDefinition Height="Auto"/> <!-- Input + action row    -->
                </Grid.RowDefinitions>

                <TextBox x:Name="TerminalOutput"
                         Grid.Row="0"
                         Style="{StaticResource TerminalOutput}"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LblPrompt"
                               Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Cmd:"/>

                    <TextBox x:Name="InputBox"
                             Grid.Column="1"
                             Style="{StaticResource InputBox}"
                             Margin="0,0,10,0"/>

                    <Button x:Name="BtnSend"
                            Grid.Column="2"
                            Style="{StaticResource ActionButton}"
                            Content="Send"
                            Margin="0,0,10,0"/>

                    <Button x:Name="BtnClear"
                            Grid.Column="3"
                            Style="{StaticResource ActionButton}"
                            Content="Clear"/>

                </Grid>

            </Grid>

            <!-- ──────────────────────────────────────────────────────────── -->
            <!--  ROW 2 - STATUS BAR                                          -->
            <!-- ──────────────────────────────────────────────────────────── -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushTitleBar}"
                    CornerRadius="0,0,10,10"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0">

                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               Grid.Column="0"
                               Text="Ready"
                               Style="{StaticResource StatusBarText}"/>

                    <TextBlock x:Name="StatusInfo"
                               Grid.Column="1"
                               Text="WTF.Console v1.00.00"
                               Style="{StaticResource StatusBarText}"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
