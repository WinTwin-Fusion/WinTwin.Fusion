<?xml version="1.0" encoding="UTF-8"?>
<!-- Dynamic WinTwin.Fusion dialog. Behavior and content are supplied by PowerShell. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MagicDialog"
        Title="Dialog"
        Width="620" Height="350"
        MinWidth="620" MaxWidth="620"
        MinHeight="350" MaxHeight="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <SolidColorBrush x:Key="BrushBg" Color="#121212"/>
    <SolidColorBrush x:Key="BrushSurface" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BrushSurface2" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="BrushTitleBar" Color="#0F0F0F"/>
    <SolidColorBrush x:Key="BrushAccent" Color="#2CEC0E"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="#43FF3D"/>
    <SolidColorBrush x:Key="BrushAccentDim" Color="#19B90A"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#F7B100"/>
    <SolidColorBrush x:Key="BrushError" Color="#F1242E"/>
    <SolidColorBrush x:Key="BrushText" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="BrushBtnClose" Color="#970F14"/>

    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="104"/>
      <Setter Property="Margin" Value="7,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
      <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
      <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource BrushAccentDim}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button">
      <Setter Property="Width" Value="28"/><Setter Property="Height" Value="22"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse x:Name="CloseCircle" Fill="{TemplateBinding Background}" Width="20" Height="20"/>
              <TextBlock x:Name="CloseGlyph" Text="×" FontSize="26" FontWeight="ExtraBold"
                         Foreground="#F1242E" HorizontalAlignment="Center" VerticalAlignment="Top"
                         Margin="0,-10,0,0" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseGlyph" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseCircle" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border CornerRadius="10" Background="{StaticResource BrushBg}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.6" Direction="270"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- Only icon, title, and close button live in the title bar. -->
      <Border Grid.Row="0" Background="{StaticResource BrushTitleBar}" CornerRadius="10,10,0,0">
        <Grid x:Name="TitleBarPanel" Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
          <Grid Grid.Column="0" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewbox x:Name="TitleIconInfo" Width="18" Height="18">
              <Canvas Width="24" Height="24"><Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="{StaticResource BrushAccent}" StrokeThickness="2"/><Ellipse Canvas.Left="11" Canvas.Top="6" Width="2" Height="2" Fill="{StaticResource BrushAccent}"/><Path Data="M12,10 L12,17" Stroke="{StaticResource BrushAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
            </Viewbox>
            <Viewbox x:Name="TitleIconWarning" Width="20" Height="20" Visibility="Collapsed">
              <Canvas Width="24" Height="24"><Path Data="M12,2 L23,21 H1 Z" Stroke="{StaticResource BrushWarning}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round"/><Path Data="M12,8 L12,14" Stroke="{StaticResource BrushWarning}" StrokeThickness="2.2" StrokeStartLineCap="Round"/><Ellipse Canvas.Left="10.8" Canvas.Top="17" Width="2.4" Height="2.4" Fill="{StaticResource BrushWarning}"/></Canvas>
            </Viewbox>
            <Viewbox x:Name="TitleIconError" Width="20" Height="20" Visibility="Collapsed">
              <Canvas Width="24" Height="24"><Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="{StaticResource BrushError}" StrokeThickness="2"/><Path Data="M8,8 L16,16 M16,8 L8,16" Stroke="{StaticResource BrushError}" StrokeThickness="2.4" StrokeStartLineCap="Round"/></Canvas>
            </Viewbox>
          </Grid>
          <TextBlock x:Name="TitleBarText" Grid.Column="1" Text="Dialog" Foreground="{StaticResource BrushTextMuted}" FontFamily="Segoe UI Semibold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <Button x:Name="BtnClose" Grid.Column="2" Style="{StaticResource CloseButton}" Background="{StaticResource BrushBtnClose}" ToolTip="Close" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{StaticResource BrushBorder}"/>

      <Grid Grid.Row="1" Margin="28,20,28,22">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="18"/><RowDefinition Height="38"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
          <Grid Width="28" Height="28" Margin="0,0,11,0">
            <Viewbox x:Name="ContentIconInfo" Width="26" Height="26"><Canvas Width="24" Height="24"><Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="{StaticResource BrushAccent}" StrokeThickness="2"/><Ellipse Canvas.Left="11" Canvas.Top="6" Width="2" Height="2" Fill="{StaticResource BrushAccent}"/><Path Data="M12,10 L12,17" Stroke="{StaticResource BrushAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
            <Viewbox x:Name="ContentIconWarning" Width="28" Height="28" Visibility="Collapsed"><Canvas Width="24" Height="24"><Path Data="M12,2 L23,21 H1 Z" Stroke="{StaticResource BrushWarning}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round"/><Path Data="M12,8 L12,14" Stroke="{StaticResource BrushWarning}" StrokeThickness="2.2" StrokeStartLineCap="Round"/><Ellipse Canvas.Left="10.8" Canvas.Top="17" Width="2.4" Height="2.4" Fill="{StaticResource BrushWarning}"/></Canvas></Viewbox>
            <Viewbox x:Name="ContentIconError" Width="28" Height="28" Visibility="Collapsed"><Canvas Width="24" Height="24"><Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="{StaticResource BrushError}" StrokeThickness="2"/><Path Data="M8,8 L16,16 M16,8 L8,16" Stroke="{StaticResource BrushError}" StrokeThickness="2.4" StrokeStartLineCap="Round"/></Canvas></Viewbox>
          </Grid>
          <TextBlock x:Name="DialogTitle" Text="Information" Foreground="{StaticResource BrushText}" FontFamily="Segoe UI Semibold" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Padding="18,14" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <TextBlock x:Name="DialogMessage" Text="Message" Foreground="{StaticResource BrushTextMuted}" FontFamily="Segoe UI" FontSize="14" TextWrapping="Wrap" LineHeight="22" VerticalAlignment="Center"/>
          </ScrollViewer>
        </Border>

        <StackPanel x:Name="ButtonPanel" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button x:Name="BtnYes" Style="{StaticResource ActionButton}" Content="Yes" Visibility="Collapsed"/>
          <Button x:Name="BtnNo" Style="{StaticResource ActionButton}" Content="No" Visibility="Collapsed"/>
          <Button x:Name="BtnOK" Style="{StaticResource ActionButton}" Content="OK" Visibility="Collapsed"/>
          <Button x:Name="BtnCancel" Style="{StaticResource ActionButton}" Content="Cancel" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
